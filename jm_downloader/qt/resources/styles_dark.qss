QWidget {
    color: #edf2ef;
    font-family: "Microsoft YaHei UI";
    font-size: 14px;
}

QMainWindow,
QWidget#windowRoot,
QStackedWidget#pageStack,
QWidget#downloadPage,
QWidget#favoritesPage,
QWidget#libraryPage,
QWidget#settingsPage {
    background: #171a18;
}

QWidget#readerPage {
    background: #141816;
}

QLabel#readerTitle {
    color: #f1f4f2;
    font-size: 18px;
    font-weight: 650;
}

QFrame#readerRule {
    border: 1px solid #4f9b73;
}

QGraphicsView#readerGraphicsView {
    background: #101311;
    border: 1px solid #343c38;
    border-radius: 6px;
}

QFrame#readerControlSidebar {
    background: #1d211f;
    border: 1px solid #343c38;
    border-radius: 8px;
}

QToolButton#readerBackButton,
QToolButton#readerChapterButton,
QToolButton#readerPreviousChapterButton,
QToolButton#readerNextChapterButton,
QToolButton#readerPreviousPageButton,
QToolButton#readerNextPageButton,
QToolButton#readerLayoutButton,
QToolButton#readerZoomButton,
QToolButton#readerRetryButton,
QToolButton#readerDownloadButton {
    min-height: 34px;
    background: #202421;
    border: 1px solid #454c48;
    border-radius: 6px;
    color: #f1f4f2;
    padding: 0 10px;
}

QToolButton#readerBackButton:hover,
QToolButton#readerChapterButton:hover,
QToolButton#readerPreviousChapterButton:hover,
QToolButton#readerNextChapterButton:hover,
QToolButton#readerPreviousPageButton:hover,
QToolButton#readerNextPageButton:hover,
QToolButton#readerLayoutButton:hover,
QToolButton#readerZoomButton:hover,
QToolButton#readerRetryButton:hover,
QToolButton#readerDownloadButton:hover {
    background: #273a30;
    border-color: #58b989;
}

QToolButton#readerDownloadButton {
    background: #3d8a64;
    border-color: #58b989;
    color: #ffffff;
}

QToolButton#readerBackButton:disabled,
QToolButton#readerChapterButton:disabled,
QToolButton#readerPreviousChapterButton:disabled,
QToolButton#readerNextChapterButton:disabled,
QToolButton#readerPreviousPageButton:disabled,
QToolButton#readerNextPageButton:disabled,
QToolButton#readerLayoutButton:disabled,
QToolButton#readerZoomButton:disabled,
QToolButton#readerRetryButton:disabled,
QToolButton#readerDownloadButton:disabled {
    background: #1b1f1d;
    border-color: #2c332f;
    color: #69736d;
}

QMenu#readerLayoutMenu,
QMenu#readerZoomMenu {
    background: #202421;
    border: 1px solid #454c48;
    padding: 4px;
}

QMenu#readerLayoutMenu::item,
QMenu#readerZoomMenu::item {
    border-radius: 5px;
    padding: 7px 24px 7px 10px;
}

QMenu#readerLayoutMenu::item:selected,
QMenu#readerZoomMenu::item:selected {
    background: #273a30;
    color: #b9e6ce;
}

QMenu#readerLayoutMenu::indicator,
QMenu#readerZoomMenu::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #58b989;
    border-radius: 5px;
    background: #20382d;
}

QMenu#readerLayoutMenu::indicator:checked,
QMenu#readerZoomMenu::indicator:checked {
    background: #58b989;
}

QSlider#readerPageSlider {
    min-width: 30px;
}

QSlider#readerPageSlider::groove:vertical {
    width: 6px;
    background: #343c38;
    border-radius: 3px;
}

QSlider#readerPageSlider::sub-page:vertical {
    background: #58b989;
    border-radius: 3px;
}

QSlider#readerPageSlider::handle:vertical {
    height: 18px;
    margin: 0 -6px;
    background: #58b989;
    border: 2px solid #171a18;
    border-radius: 9px;
}

QLabel#readerErrorBanner {
    background: #3a211b;
    border: 1px solid #b8644f;
    border-radius: 6px;
    color: #f1b7a8;
    padding: 7px 10px;
}

QDialog#readerChapterDialog,
QDialog#readerChapterDialog QWidget#qt_scrollarea_viewport,
QWidget#readerChapterCanvas {
    background: #181b19;
    color: #f1f4f2;
}

QLabel#readerChapterDialogTitle {
    font-size: 18px;
    font-weight: 650;
}

QLabel#readerChapterDialogDetail {
    color: #aeb8b2;
}

QRadioButton#readerChapterOption {
    background: #202421;
    border: 1px solid #454c48;
    border-radius: 6px;
    padding: 8px;
    spacing: 10px;
}

QRadioButton#readerChapterOption:hover {
    background: #273a30;
    border-color: #58b989;
}

QRadioButton#readerChapterOption::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #4f9b73;
    border-radius: 9px;
    background: transparent;
}

QRadioButton#readerChapterOption::indicator:checked {
    background: qradialgradient(
        cx: 0.5, cy: 0.5, radius: 0.5, fx: 0.5, fy: 0.5,
        stop: 0 #4f9b73,
        stop: 0.44 #4f9b73,
        stop: 0.45 transparent,
        stop: 1 transparent
    );
}

QPushButton#readerChapterCancelButton {
    min-height: 34px;
    min-width: 88px;
    background: #202421;
    border: 1px solid #454c48;
    border-radius: 6px;
    color: #f1f4f2;
}

QWidget#sidebar {
    background: #111412;
    border-right: 1px solid #090b0a;
}

QWidget#brand {
    background: transparent;
}

QLabel#brandMark {
    background: #58b989;
    border-radius: 6px;
    color: #101512;
    font-size: 15px;
    font-weight: 700;
}

QLabel#brandName {
    background: transparent;
    color: #f4f7f5;
    font-size: 15px;
    font-weight: 600;
}

QToolButton#navButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    color: #cfd6d2;
    padding: 0 12px;
    text-align: left;
}

QToolButton#navButton:hover {
    background: #222724;
    border-color: #363c38;
}

QToolButton#navButton:checked {
    background: #346b50;
    border-color: #4d8a6a;
    color: #ffffff;
    font-weight: 600;
}

QLabel#pageTitle {
    color: #edf2ef;
    font-size: 24px;
    font-weight: 650;
}

QLabel#sectionTitle {
    color: #edf2ef;
    font-size: 16px;
    font-weight: 600;
}

QLabel#comicAuthor,
QLabel#comicMetadata,
QLabel#coverCaption {
    color: #a8b0ab;
}

QFrame#pageRule {
    background: #3b423e;
    border: none;
}

QLineEdit#generalSearchInput,
QLineEdit#jmIdSearchInput {
    background: #232725;
    border: 1px solid #454c48;
    border-radius: 6px;
    color: #edf2ef;
    min-height: 40px;
    padding: 0 12px;
    selection-background-color: #58b989;
    selection-color: #101512;
}

QLineEdit#generalSearchInput:hover,
QLineEdit#jmIdSearchInput:hover {
    border-color: #69736d;
}

QLineEdit#generalSearchInput:focus,
QLineEdit#jmIdSearchInput:focus {
    border: 2px solid #58b989;
    padding: 0 11px;
}

QFrame#searchHistoryMenu {
    background: #232725;
    border: 1px solid #59635d;
    border-radius: 6px;
}

QScrollArea#searchHistoryScroll,
QWidget#searchHistoryContent {
    background: #232725;
    border: none;
}

QFrame#searchHistoryRow {
    background: transparent;
    border: none;
    border-radius: 4px;
}

QFrame#searchHistoryRow:hover {
    background: #343a36;
}

QToolButton#searchHistoryEntryButton {
    background: transparent;
    border: none;
    color: #edf2ef;
    text-align: left;
    padding: 0 8px;
}

QToolButton#searchHistoryDeleteButton {
    background: transparent;
    border: none;
    border-radius: 4px;
}

QToolButton#searchHistoryDeleteButton:hover {
    background: #402727;
}

QLineEdit#generalSearchInput:disabled,
QLineEdit#jmIdSearchInput:disabled {
    background: #1d211f;
    color: #777f7a;
}

QScrollArea#resultsScroll,
QScrollArea#tasksScroll,
QScrollArea#favoritesResultsScroll,
QScrollArea#libraryScrollArea {
    background: transparent;
    border: none;
}

QScrollArea#resultsScroll > QWidget > QWidget,
QScrollArea#tasksScroll > QWidget > QWidget,
QScrollArea#favoritesResultsScroll > QWidget > QWidget,
QScrollArea#libraryScrollArea > QWidget > QWidget {
    background: #171a18;
}

QFrame#comicCard {
    background: #232725;
    border: 1px solid #3b423e;
    border-radius: 8px;
}

QFrame#comicCard:hover {
    border-color: #59635d;
}

QWidget#coverPlaceholder,
QLabel#coverPlaceholder {
    background: #2e3431;
    border: none;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    color: #99a39d;
}

QLabel#comicTitle {
    color: #edf2ef;
    font-size: 14px;
    font-weight: 600;
}

QLabel#coverMark {
    color: #a8b0ab;
    font-size: 24px;
    font-weight: 700;
}

QFrame#settingsRow {
    border-bottom: 1px solid #3b423e;
}

QToolButton#themeButton {
    background: #2a2f2c;
    border: 1px solid #454c48;
    border-radius: 6px;
    color: #cbd2ce;
    min-height: 34px;
    min-width: 68px;
    padding: 0 10px;
}

QToolButton#themeButton:hover {
    background: #343a36;
    border-color: #5d6761;
}

QToolButton#themeButton:checked {
    background: #58b989;
    border-color: #58b989;
    color: #101512;
    font-weight: 600;
}

QScrollBar:vertical {
    background: transparent;
    margin: 2px;
    width: 10px;
}

QScrollBar::handle:vertical {
    background: #4a524d;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #616b65;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
    border: none;
    height: 0;
}

QTabBar#downloadViewTabs::tab {
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    color: #a8b0ab;
    min-width: 88px;
    padding: 8px 14px;
}

QTabBar#downloadViewTabs::tab:hover {
    color: #edf2ef;
}

QTabBar#downloadViewTabs::tab:selected {
    border-bottom-color: #58b989;
    color: #edf2ef;
    font-weight: 600;
}

QLineEdit#downloadAlbumInput {
    background: #232725;
    border: 1px solid #454c48;
    border-radius: 6px;
    color: #edf2ef;
    padding: 0 12px;
    selection-background-color: #58b989;
    selection-color: #101512;
}

QLineEdit#downloadAlbumInput:focus {
    border: 2px solid #58b989;
    padding: 0 11px;
}

QPushButton#startDownloadButton {
    background: #58b989;
    border: 1px solid #58b989;
    border-radius: 6px;
    color: #101512;
    font-weight: 600;
}

QPushButton#startDownloadButton:hover {
    background: #6bc697;
    border-color: #6bc697;
}

QPushButton#startDownloadButton:disabled {
    background: #343a36;
    border-color: #454c48;
    color: #777f7a;
}

QToolButton#taskBatchManageButton,
QToolButton#taskBatchSelectAllButton,
QToolButton#taskBatchPauseButton,
QToolButton#taskBatchResumeButton,
QToolButton#taskBatchCancelButton,
QToolButton#taskBatchExitButton {
    background: #232725;
    border: 1px solid #454c48;
    border-radius: 6px;
    color: #edf2ef;
    min-height: 30px;
    padding: 0 9px;
}

QToolButton#taskBatchManageButton:hover,
QToolButton#taskBatchSelectAllButton:hover,
QToolButton#taskBatchPauseButton:hover,
QToolButton#taskBatchResumeButton:hover,
QToolButton#taskBatchCancelButton:hover,
QToolButton#taskBatchExitButton:hover {
    background: #343a36;
    border-color: #59635d;
}

QToolButton#taskBatchManageButton:checked,
QToolButton#taskBatchCancelButton {
    background: #58b989;
    border-color: #58b989;
    color: #101512;
}

QToolButton#taskBatchManageButton:disabled,
QToolButton#taskBatchSelectAllButton:disabled,
QToolButton#taskBatchPauseButton:disabled,
QToolButton#taskBatchResumeButton:disabled,
QToolButton#taskBatchCancelButton:disabled {
    background: #343a36;
    border-color: #454c48;
    color: #777f7a;
}

QFrame#taskBatchSelectionBar {
    background: #202c26;
    border: 1px solid #365d49;
    border-radius: 6px;
}

QLabel#taskBatchSelectedCount {
    color: #79cfa3;
    font-weight: 600;
}

QLabel#taskBatchFeedback {
    color: #a8b0ab;
    font-size: 12px;
}

QFrame#downloadTaskRow {
    background: #232725;
    border: 1px solid #3b423e;
    border-left: 3px solid #59635d;
    border-radius: 6px;
}

QFrame#downloadTaskRow[status="fetching"] {
    border-left-color: #d49a4a;
}

QFrame#downloadTaskRow[status="downloading"] {
    border-left-color: #58b989;
}

QFrame#downloadTaskRow[status="pausing"],
QFrame#downloadTaskRow[status="cancelling"] {
    border-left-color: #b49a76;
}

QFrame#downloadTaskRow[status="paused"] {
    border-left-color: #8297b0;
}

QFrame#downloadTaskRow[status="completed"] {
    border-left-color: #58b989;
}

QFrame#downloadTaskRow[status="failed"] {
    border-left-color: #d96c6c;
}

QFrame#downloadTaskRow[selected="true"] {
    border: 2px solid #58b989;
    border-left: 3px solid #58b989;
}

QCheckBox#batchTaskSelectionCheck::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #58b989;
    border-radius: 5px;
    background: #232725;
}

QCheckBox#batchTaskSelectionCheck::indicator:checked {
    background: #58b989;
}

QLabel#taskPreview {
    background: #2e3431;
    border: 1px solid #3b423e;
    border-radius: 4px;
    color: #a8b0ab;
    font-size: 17px;
    font-weight: 700;
}

QLabel#taskKicker,
QLabel#taskDetail {
    color: #a8b0ab;
    font-size: 12px;
}

QLabel#taskTitle {
    color: #edf2ef;
    font-size: 14px;
    font-weight: 600;
}

QProgressBar#taskProgress {
    background: #343a36;
    border: none;
    border-radius: 3px;
}

QProgressBar#taskProgress::chunk {
    background: #58b989;
    border-radius: 3px;
}

QLabel#taskStatus {
    background: #2a2f2c;
    border-radius: 3px;
    color: #a8b0ab;
    font-size: 11px;
    font-weight: 600;
    padding: 3px 7px;
}

QLabel#taskStatus[status="fetching"] {
    background: #3d3221;
    color: #e4b46f;
}

QLabel#taskStatus[status="downloading"],
QLabel#taskStatus[status="completed"] {
    background: #20382d;
    color: #79cfa3;
}

QLabel#taskStatus[status="pausing"],
QLabel#taskStatus[status="cancelling"] {
    background: #3a3228;
    color: #cfb58e;
}

QLabel#taskStatus[status="paused"] {
    background: #293442;
    color: #a9bdd4;
}

QLabel#taskStatus[status="failed"] {
    background: #402727;
    color: #e68b8b;
}

QWidget#taskActions QToolButton {
    background: transparent;
    border: 1px solid #3b423e;
    border-radius: 5px;
}

QWidget#taskActions QToolButton:hover {
    background: #343a36;
    border-color: #59635d;
}

QLabel#emptyTasksLabel {
    border: 1px dashed #454c48;
    color: #a8b0ab;
}

QLineEdit#librarySearchInput {
    background: #232725;
    border: 1px solid #454c48;
    border-radius: 6px;
    color: #edf2ef;
    padding: 0 12px;
    selection-background-color: #58b989;
    selection-color: #101512;
}

QLineEdit#librarySearchInput:focus {
    border: 2px solid #58b989;
    padding: 0 11px;
}

QFrame#libraryFilterSegment {
    background: #202421;
    border: 1px solid #3b423e;
    border-radius: 6px;
}

QToolButton#libraryFilterButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 5px;
    color: #a8b0ab;
}

QToolButton#libraryFilterButton:hover {
    background: #343a36;
    color: #edf2ef;
}

QToolButton#libraryFilterButton:checked {
    background: #2e3431;
    border-color: #454c48;
    color: #edf2ef;
    font-weight: 600;
}

QToolButton#refreshLibraryButton {
    background: #232725;
    border: 1px solid #454c48;
    border-radius: 6px;
}

QToolButton#refreshLibraryButton:hover {
    background: #343a36;
    border-color: #59635d;
}

QToolButton#refreshLibraryButton:disabled {
    background: #202421;
    border-color: #343a36;
}

QToolButton#librarySortButton,
QToolButton#librarySelectButton,
QToolButton#libraryDeleteSelectedButton,
QToolButton#libraryCancelSelectionButton {
    background: #232725;
    border: 1px solid #454c48;
    border-radius: 6px;
    color: #edf2ef;
    padding: 0 9px;
}

QToolButton#librarySortButton:hover,
QToolButton#librarySelectButton:hover,
QToolButton#libraryDeleteSelectedButton:hover,
QToolButton#libraryCancelSelectionButton:hover {
    background: #343a36;
    border-color: #59635d;
}

QToolButton#librarySelectButton:checked,
QToolButton#libraryDeleteSelectedButton {
    background: #58b989;
    border-color: #58b989;
    color: #101512;
}

QToolButton#libraryDeleteSelectedButton:disabled {
    background: #202421;
    border-color: #343a36;
    color: #69736d;
}

QFrame#librarySelectionBar {
    background: #20382d;
    border: 1px solid #35664e;
    border-radius: 6px;
}

QLabel#librarySelectedCount {
    color: #79cfa3;
    font-weight: 600;
}

QLabel#libraryCountLabel,
QLabel#libraryMeta {
    color: #a8b0ab;
    font-size: 12px;
}

QProgressBar#libraryLoadingBar {
    background: #343a36;
    border: none;
}

QProgressBar#libraryLoadingBar::chunk {
    background: #58b989;
}

QFrame#libraryErrorBanner {
    background: #402727;
    border: 1px solid #684141;
    border-radius: 5px;
}

QLabel#libraryErrorLabel {
    color: #e68b8b;
    font-size: 12px;
}

QFrame#libraryItemCard {
    background: #232725;
    border: 1px solid #3b423e;
    border-radius: 6px;
}

QFrame#libraryItemCard:hover {
    border-color: #59635d;
}

QFrame#libraryItemCard[selected="true"] {
    border: 2px solid #58b989;
}

QCheckBox#librarySelectionCheck::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #58b989;
    border-radius: 5px;
    background: #232725;
}

QCheckBox#librarySelectionCheck::indicator:checked {
    background: #58b989;
}

QCheckBox#librarySelectionCheck::indicator:disabled {
    border-color: #59635d;
    background: #202421;
}

QLabel#libraryPreview {
    background: #2e3431;
    border: 1px solid #3b423e;
    border-radius: 4px;
    color: #a8b0ab;
    font-size: 17px;
    font-weight: 700;
}

QLabel#libraryAlbumId {
    color: #edf2ef;
    font-size: 15px;
    font-weight: 650;
}

QLabel#libraryState {
    background: #2a2f2c;
    border-radius: 3px;
    color: #a8b0ab;
    font-size: 11px;
    font-weight: 600;
    padding: 3px 7px;
}

QLabel#libraryState[state="active"] {
    background: #3d3221;
    color: #e4b46f;
}

QLabel#libraryState[state="busy"] {
    background: #20382d;
    color: #79cfa3;
}

QLabel#libraryState[state="legacy"] {
    background: #3b311e;
    color: #e3b76b;
}

QWidget#libraryActions QToolButton {
    background: transparent;
    border: 1px solid #3b423e;
    border-radius: 5px;
}

QWidget#libraryActions QToolButton:hover {
    background: #343a36;
    border-color: #59635d;
}

QWidget#libraryActions QToolButton:pressed {
    background: #3b433e;
    border-color: #6c7871;
}

QWidget#libraryActions QToolButton:focus {
    border: 2px solid #58b989;
}

QWidget#libraryActions QToolButton:disabled {
    background: #202421;
    border-color: #343a36;
    color: #69736d;
}

QWidget#libraryPrimaryActions QToolButton {
    padding: 0 6px;
}

QToolButton#libraryReadButton {
    background: #58b989;
    border-color: #58b989;
    color: #ffffff;
    font-weight: 600;
}

QToolButton#libraryReadButton:hover {
    background: #6bc697;
    border-color: #6bc697;
}

QToolButton#libraryReadButton:pressed {
    background: #48a97a;
    border-color: #48a97a;
}

QToolButton#libraryReadButton:focus {
    border: 2px solid #8bd7ad;
}

QToolButton#libraryReadButton:disabled {
    background: #2a2f2c;
    border-color: #3b423e;
    color: #777f7a;
}

QMenu#libraryDeleteMenu,
QMenu#librarySortMenu,
QMenu#libraryDeleteSelectedMenu {
    background: #232725;
    border: 1px solid #454c48;
    color: #edf2ef;
    padding: 4px;
}

QMenu#libraryDeleteMenu::item,
QMenu#librarySortMenu::item,
QMenu#libraryDeleteSelectedMenu::item {
    border-radius: 4px;
    padding: 7px 24px 7px 10px;
}

QMenu#libraryDeleteMenu::item:selected,
QMenu#librarySortMenu::item:selected,
QMenu#libraryDeleteSelectedMenu::item:selected {
    background: #343a36;
}

QMenu#libraryDeleteMenu::item:disabled,
QMenu#librarySortMenu::item:disabled,
QMenu#libraryDeleteSelectedMenu::item:disabled {
    color: #69736d;
}

QLabel#libraryEmptyLabel {
    color: #a8b0ab;
    font-size: 14px;
}

QPushButton#retryLibraryButton {
    background: #232725;
    border: 1px solid #454c48;
    border-radius: 6px;
    color: #edf2ef;
}

QPushButton#retryLibraryButton:hover {
    background: #343a36;
    border-color: #59635d;
}

QScrollArea#settingsScrollArea {
    background: transparent;
    border: none;
}

QScrollArea#settingsScrollArea > QWidget > QWidget,
QWidget#settingsCanvas,
QFrame#settingsSection,
QWidget#settingsInlineControl,
QWidget#settingsComboControl,
QWidget#settingsThemeControl,
QWidget#settingsStepper {
    background: #171a18;
}

QLabel#settingsLabel {
    color: #cbd2ce;
}

QLabel#settingsSizeSeparator {
    color: #8d9690;
}

QLineEdit#settingsPathInput,
QComboBox#settingsComboBox,
QSpinBox#settingsSpinBox {
    background: #232725;
    border: 1px solid #454c48;
    border-radius: 6px;
    color: #edf2ef;
    min-height: 34px;
    padding: 0 10px;
    selection-background-color: #58b989;
    selection-color: #101512;
}

QLineEdit#settingsPathInput:hover,
QComboBox#settingsComboBox:hover,
